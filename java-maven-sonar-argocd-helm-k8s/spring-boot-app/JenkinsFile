pipeline {
    agent any

    tools {
        jdk 'jdk11'
        maven 'maven'
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    environment {
        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        MANIFEST = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'
        SONAR_URL = 'http://localhost:9000'
        DOCKER_IMAGE = "sibu2403/spring-boot-app:${BUILD_NUMBER}"
        GIT_USER_NAME = 'sibuprasad24-afk'
        GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        java -version
                        mvn -version
                        mvn clean package
                    '''
                }
            }
        }

        stage('Static Code Analysis and Quality Gate') {
            tools {
                jdk 'jdk21'
            }
            steps {
                dir("${APP_DIR}") {
                    withCredentials([
                        string(
                            credentialsId: 'sonarqube',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set +x
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                            -Dsonar.host.url=$SONAR_URL \
                            -Dsonar.projectKey=spring-boot-app \
                            -Dsonar.qualitygate.wait=true \
                            -Dsonar.qualitygate.timeout=300
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh 'docker build -t "$DOCKER_IMAGE" .'
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        docker.image(env.DOCKER_IMAGE).push()
                    }
                }
            }
        }

        stage('Update Deployment Manifest') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x

                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@example.com"

                        sed -i "s|image: .*|image: ${DOCKER_IMAGE}|" "$MANIFEST"

                        git add "$MANIFEST"

                        if git diff --cached --quiet; then
                            echo "No manifest changes required"
                        else
                            git commit -m "Update deployment image to ${BUILD_NUMBER} [skip ci]"

                            AUTH=$(printf '%s:%s' "$GIT_USER_NAME" "$GITHUB_TOKEN" | base64 -w0)

                            git -c http.extraHeader="Authorization: Basic $AUTH" \
                            push "https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" HEAD:main
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI pipeline completed successfully!'
        }

        failure {
            echo 'CI pipeline failed. Check console output.'
        }

        always {
            cleanWs()
        }
    }
}
